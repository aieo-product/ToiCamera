; Copy to secrets.ini and fill in. secrets.ini is gitignored — never commit real values.
;
; Two WiFi slots: slot 1 = home LAN, slot 2 = phone hotspot (demo fallback).
; WORKER_URL  : YOUR deployed Cloudflare Worker base URL (https, no trailing
;               slash). Deploy worker/ first — see the Worker setup guide (aieo-product.github.io/ToiCamera).
; DEVICE_TOKEN: must match the Worker's DEVICE_TOKEN secret.
;
; The CamS3 camera needs no address here — it joins the watch's SoftAP
; "ToiCamera" and is discovered automatically.

[secrets]
build_flags =
  -DWIFI_SSID1=\"your-home-ssid\"
  -DWIFI_PASS1=\"your-home-password\"
  -DWIFI_SSID2=\"your-hotspot-ssid\"
  -DWIFI_PASS2=\"your-hotspot-password\"
  -DWORKER_URL=\"https://toicamera.your-subdomain.workers.dev\"
  -DDEVICE_TOKEN=\"change-me\"
