+/**
+ * @file server_sta.cpp
+ * @brief ToiCamera: connect to the host's WiFi (STA) and serve the same
+ *        REST API as the factory AP server. Falls back to the AP server if
+ *        the connection cannot be established (lockout prevention).
+ */
+#include "../hal_unitcam_s3_5mp.h"
+#include "../hal_config.h"
+#include <mooncake.h>
+#include <Arduino.h>
+#include <WiFi.h>
+#include <AsyncTCP.h>
+#include <ESPAsyncWebServer.h>
+#include <FS.h>
+#include <LittleFS.h>
+#include "apis/apis.h"
+#include <assets/assets.h>
+
+static AsyncWebServer* _sta_server = nullptr;
+
+void HAL_UnitCamS3_5MP::startStaServer()
+{
+    spdlog::info("start sta server, try connect: {}", HAL::GetSystemConfig().wifiSsid);
+
+    WiFi.mode(WIFI_STA);
+    WiFi.setAutoReconnect(true);
+    WiFi.begin(HAL::GetSystemConfig().wifiSsid.c_str(), HAL::GetSystemConfig().wifiPass.c_str());
+
+    uint32_t t0 = millis();
+    bool led = false;
+    while (WiFi.status() != WL_CONNECTED)
+    {
+        if (millis() - t0 > 30000)
+        {
+            spdlog::error("sta connect timeout, fall back to ap server");
+            WiFi.disconnect(true);
+            startApServer();
+            return;
+        }
+        delay(250);
+        led = !led;
+        HAL::SetLedState(led);  // fast blink while connecting
+    }
+    spdlog::info("sta ip: {}", WiFi.localIP().toString().c_str());
+
+    _sta_server = new AsyncWebServer(80);
+    load_cam_apis(*_sta_server);
+    load_mic_apis(*_sta_server);
+    load_system_apis(*_sta_server);
+    load_poster_apis(*_sta_server);
+    _sta_server->begin();
+    spdlog::info("sta web server started");
+
+    HAL::SetLedState(true);
+}
