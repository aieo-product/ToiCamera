{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toicamera",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Voice + model for TTS at AUDIO_API_BASE_URL. The device shows the voice
    // name in Settings (via GET /config).
    "TTS_VOICE": "marin",
    "TTS_MODEL": "gpt-4o-mini-tts",
    // Model menu ToiCamera shows in Settings (comma-separated). The device
    // fetches it via GET /config and echoes one entry back as X-Model.
    // The FIRST entry is the default when none is selected.
    "MODELS": "gpt-5.6-terra,gpt-5.6-luna",
    // OpenAI-compatible base URL of the main chat/vision backend. Point at a
    // Cloudflare Tunnel to use a local LLM (e.g. Ollama: https://<host>/v1).
    "MAIN_API_BASE_URL": "https://api.openai.com/v1",
    // Output shaping — what ToiCamera's AI-detail (AI精度) low/high toggle
    // MEANS is decided here, so depth/length are tunable without a firmware
    // update. Style lines are appended to the analyze system prompt.
    "ANALYZE_MAX_TOKENS": "500",
    "ANALYZE_STYLE_LOW": "",
    "ANALYZE_STYLE_HIGH": "Look closely at fine details in the image. Make `detail` 4-5 sentences with deeper observations (up to ~250 characters in ja/zh).",
    // On-device sanoTTS voice (firmware voice mode "sanoTTS"): the device
    // needs the text as a kana intermediate representation. With
    // KANA_BUNDLE=1 it is bundled into /analyze when the device sends
    // X-Kana: 1; "0" makes the device fall back to POST /kana instead.
    // Measured 2026-09-03 (gpt-5.6-terra, low detail): bundled at the model's
    // default reasoning ~11 s, at "none" ~4.5 s (= plain /analyze), separate
    // /analyze + /kana ~7 s. So the bundled call runs at reasoning "none".
    "KANA_BUNDLE": "1",
    "ANALYZE_KANA_REASONING_EFFORT": "none",
    "KANA_REASONING_EFFORT": "none",
    // "GPT Realtime" voice mode: /tts with {"engine":"realtime"} is spoken by
    // the OpenAI Realtime API (WebSocket) instead of /audio/speech. Reuses
    // TOICAMERA_TTS_API_KEY as the bearer token — Realtime is OpenAI-only, so
    // this does not follow AUDIO_API_BASE_URL (an https:// base; the Worker
    // upgrades it to a WebSocket itself). Falls back to the regular TTS engine
    // (and then chirps on-device) if Realtime fails. REALTIME_VOICE must be a
    // Realtime voice (alloy/ash/ballad/coral/echo/sage/shimmer/verse/marin/
    // cedar); empty = reuse TTS_VOICE.
    "REALTIME_MODEL": "gpt-realtime",
    "REALTIME_VOICE": "marin",
    "REALTIME_API_BASE_URL": "https://api.openai.com/v1",
    // POST /live (the device's "GPT Realtime" voice mode): one upstream
    // session turns the photo (+ the recorded question) into streamed speech.
    // LIVE_ENGINE picks the upstream:
    //   "gpt-live"  (default) GPT-Live-1 on /v1/live/sessions. The voice model
    //               only speaks; the photo and every factual question are
    //               delegated to LIVE_BACKEND_MODEL over Responses, so the
    //               answer is actually reasoned about.
    //   "realtime"  the older gpt-realtime one-shot (REALTIME_* vars above).
    // With "gpt-live", a GPT-Live failure BEFORE any audio reached the device
    // falls back to the Realtime driver inside the same request, so the device
    // never hears silence. Reuses TOICAMERA_TTS_API_KEY as the bearer token.
    // LIVE_BACKEND_MODEL must be vision-capable (it is the one that sees the
    // JPEG); gpt-5.6-luna is the cheaper backend. LIVE_BACKEND_REASONING is
    // reasoning.effort for it (default low; none/low/medium/high — reasoning
    // tokens share max_output_tokens=2000 with the answer).
    // LIVE_VOICE must be a GPT-Live voice name.
    "LIVE_ENGINE": "gpt-live",
    "LIVE_MODEL": "gpt-live-1",
    "LIVE_BACKEND_MODEL": "gpt-5.6-terra",
    "LIVE_BACKEND_REASONING": "low",
    "LIVE_VOICE": "marin",
    "LIVE_API_BASE_URL": "https://api.openai.com/v1",
    // ms of upstream silence (after the delegated answer completed) that ends
    // a /live answer. Raise it if answers get cut between sentences.
    "LIVE_END_SILENCE_MS": "1500"
  }
  // Secrets (set via `npx wrangler secret put <NAME>`):
  //   TOICAMERA_MAIN_API_KEY — API key of YOUR chat/vision backend (OpenAI,
  //                            Anthropic, or whatever MAIN_API_BASE_URL points at)
  //   TOICAMERA_TTS_API_KEY  — key for voice STT/TTS (AUDIO_API_BASE_URL,
  //                            default api.openai.com; optional — chirps otherwise)
  //   DEVICE_TOKEN           — shared token ToiCamera sends as X-Device-Token
  //                            (the value typed into ToiCamera's WiFi portal)
}
